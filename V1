<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Metric to Imperial Converter</title>
  <style>
    :root {
      --bg: #0b1020;
      --card: #121a33;
      --text: #eef2ff;
      --muted: #aab3d6;
      --accent: #6ea8fe;
      --border: rgba(255,255,255,0.16);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
      color: var(--text);
      background: radial-gradient(1000px 500px at 15% 0%, #18224a 0%, var(--bg) 55%);
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 16px;
    }
    .card {
      width: min(760px, 100%);
      background: rgba(18,26,51,0.94);
      border: 1px solid var(--border);
      border-radius: 14px;
      box-shadow: 0 14px 32px rgba(0,0,0,0.3);
      padding: 18px;
    }
    h1 { margin: 0 0 8px; font-size: 1.5rem; }
    .sub { color: var(--muted); margin: 0 0 14px; font-size: .95rem; }
    .mode {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 14px;
    }
    .mode button {
      border: 1px solid var(--border);
      background: rgba(255,255,255,0.08);
      color: var(--text);
      padding: 9px 12px;
      border-radius: 10px;
      cursor: pointer;
      font-weight: 650;
    }
    .mode button.active {
      border-color: rgba(110,168,254,.5);
      background: rgba(110,168,254,.22);
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
    @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
    label { color: var(--muted); font-size: .85rem; display:block; margin-bottom: 6px; }
    input, select {
      width: 100%;
      padding: 10px 12px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: rgba(255,255,255,0.05);
      color: var(--text);
      outline: none;
    }
    .row { display: flex; gap: 8px; align-items: end; flex-wrap: wrap; }
    .row button {
      border: 1px solid var(--border);
      background: rgba(81,207,102,.16);
      color: var(--text);
      padding: 10px 14px;
      border-radius: 10px;
      cursor: pointer;
      font-weight: 650;
    }
    .result {
      margin-top: 14px;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px;
      background: rgba(255,255,255,.06);
      font-variant-numeric: tabular-nums;
      min-height: 48px;
      display: grid;
      align-items: center;
    }
  </style>
</head>
<body>
  <main class="card">
    <h1>Metric to Imperial Converter</h1>
    <p class="sub">Switch modes to convert either Metric → Imperial or Imperial → Metric.</p>

    <div class="mode">
      <button id="metricToImperialBtn" class="active" type="button">Metric → Imperial</button>
      <button id="imperialToMetricBtn" type="button">Imperial → Metric</button>
    </div>

    <div class="grid">
      <div>
        <label for="valueInput">Value</label>
        <input id="valueInput" type="number" step="any" value="1" />
      </div>
      <div>
        <label for="categorySelect">Category</label>
        <select id="categorySelect"></select>
      </div>
      <div>
        <label for="fromUnitSelect">From unit</label>
        <select id="fromUnitSelect"></select>
      </div>
      <div>
        <label for="toUnitSelect">To unit</label>
        <select id="toUnitSelect"></select>
      </div>
    </div>

    <div class="row" style="margin-top: 10px;">
      <button id="convertBtn" type="button">Convert</button>
    </div>

    <div class="result" id="result"></div>
  </main>

  <script>
    const unitDefs = {
      length: {
        metric: {
          millimeter: { label: "millimeter (mm)", toBase: v => v / 1000, fromBase: v => v * 1000 },
          centimeter: { label: "centimeter (cm)", toBase: v => v / 100, fromBase: v => v * 100 },
          meter: { label: "meter (m)", toBase: v => v, fromBase: v => v },
          kilometer: { label: "kilometer (km)", toBase: v => v * 1000, fromBase: v => v / 1000 }
        },
        imperial: {
          inch: { label: "inch (in)", toBase: v => v * 0.0254, fromBase: v => v / 0.0254 },
          foot: { label: "foot (ft)", toBase: v => v * 0.3048, fromBase: v => v / 0.3048 },
          yard: { label: "yard (yd)", toBase: v => v * 0.9144, fromBase: v => v / 0.9144 },
          mile: { label: "mile (mi)", toBase: v => v * 1609.344, fromBase: v => v / 1609.344 }
        }
      },
      mass: {
        metric: {
          gram: { label: "gram (g)", toBase: v => v / 1000, fromBase: v => v * 1000 },
          kilogram: { label: "kilogram (kg)", toBase: v => v, fromBase: v => v },
          tonne: { label: "tonne (metric ton)", toBase: v => v * 1000, fromBase: v => v / 1000 }
        },
        imperial: {
          ounce: { label: "ounce (oz)", toBase: v => v * 0.028349523125, fromBase: v => v / 0.028349523125 },
          pound: { label: "pound (lb)", toBase: v => v * 0.45359237, fromBase: v => v / 0.45359237 },
          ton_us: { label: "short ton (US)", toBase: v => v * 907.18474, fromBase: v => v / 907.18474 }
        }
      },
      volume: {
        metric: {
          milliliter: { label: "milliliter (mL)", toBase: v => v / 1000, fromBase: v => v * 1000 },
          liter: { label: "liter (L)", toBase: v => v, fromBase: v => v }
        },
        imperial: {
          floz: { label: "fluid ounce (US)", toBase: v => v * 0.0295735295625, fromBase: v => v / 0.0295735295625 },
          cup: { label: "cup (US)", toBase: v => v * 0.2365882365, fromBase: v => v / 0.2365882365 },
          pint: { label: "pint (US)", toBase: v => v * 0.473176473, fromBase: v => v / 0.473176473 },
          gallon: { label: "gallon (US)", toBase: v => v * 3.785411784, fromBase: v => v / 3.785411784 }
        }
      },
      temperature: {
        metric: {
          celsius: { label: "celsius (°C)", toBase: v => v, fromBase: v => v },
          kelvin: { label: "kelvin (K)", toBase: v => v - 273.15, fromBase: v => v + 273.15 }
        },
        imperial: {
          fahrenheit: { label: "fahrenheit (°F)", toBase: v => (v - 32) * 5 / 9, fromBase: v => (v * 9 / 5) + 32 }
        }
      }
    };

    const categoryLabels = {
      length: "Length",
      mass: "Mass",
      volume: "Volume",
      temperature: "Temperature"
    };

    const valueInput = document.getElementById("valueInput");
    const categorySelect = document.getElementById("categorySelect");
    const fromUnitSelect = document.getElementById("fromUnitSelect");
    const toUnitSelect = document.getElementById("toUnitSelect");
    const result = document.getElementById("result");
    const convertBtn = document.getElementById("convertBtn");
    const metricToImperialBtn = document.getElementById("metricToImperialBtn");
    const imperialToMetricBtn = document.getElementById("imperialToMetricBtn");

    let mode = "metric_to_imperial";

    function sidesForMode() {
      return mode === "metric_to_imperial"
        ? { fromSide: "metric", toSide: "imperial" }
        : { fromSide: "imperial", toSide: "metric" };
    }

    function setMode(nextMode) {
      mode = nextMode;
      metricToImperialBtn.classList.toggle("active", mode === "metric_to_imperial");
      imperialToMetricBtn.classList.toggle("active", mode === "imperial_to_metric");
      populateCategories();
      convert();
    }

    function populateCategories() {
      const previous = categorySelect.value;
      categorySelect.innerHTML = "";
      for (const [key, label] of Object.entries(categoryLabels)) {
        categorySelect.add(new Option(label, key));
      }
      categorySelect.value = previous || "length";
      populateUnits();
    }

    function populateUnits() {
      const cat = categorySelect.value;
      const { fromSide, toSide } = sidesForMode();
      const fromUnits = unitDefs[cat][fromSide];
      const toUnits = unitDefs[cat][toSide];

      fromUnitSelect.innerHTML = "";
      toUnitSelect.innerHTML = "";

      for (const [key, info] of Object.entries(fromUnits)) fromUnitSelect.add(new Option(info.label, key));
      for (const [key, info] of Object.entries(toUnits)) toUnitSelect.add(new Option(info.label, key));
    }

    function fmt(n) {
      return Number.parseFloat(n.toPrecision(12)).toString();
    }

    function convert() {
      const cat = categorySelect.value;
      const { fromSide, toSide } = sidesForMode();
      const value = Number(valueInput.value);

      if (!Number.isFinite(value)) {
        result.textContent = "Please enter a valid number.";
        return;
      }

      const from = unitDefs[cat][fromSide][fromUnitSelect.value];
      const to = unitDefs[cat][toSide][toUnitSelect.value];

      const baseValue = from.toBase(value);
      const converted = to.fromBase(baseValue);
      result.textContent = `${fmt(value)} ${from.label} = ${fmt(converted)} ${to.label}`;
    }

    categorySelect.addEventListener("change", () => {
      populateUnits();
      convert();
    });
    fromUnitSelect.addEventListener("change", convert);
    toUnitSelect.addEventListener("change", convert);
    valueInput.addEventListener("input", convert);
    convertBtn.addEventListener("click", convert);
    metricToImperialBtn.addEventListener("click", () => setMode("metric_to_imperial"));
    imperialToMetricBtn.addEventListener("click", () => setMode("imperial_to_metric"));

    setMode("metric_to_imperial");
  </script>
</body>
</html>
