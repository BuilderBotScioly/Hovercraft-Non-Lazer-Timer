<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Imperial ↔ Metric Converter</title>
  <style>
    :root {
      --bg: #0f172a;
      --card: #111827;
      --text: #e5e7eb;
      --muted: #94a3b8;
      --accent: #22c55e;
      --border: rgba(148,163,184,0.35);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      background: radial-gradient(1000px 500px at 10% 0%, #1e293b 0%, var(--bg) 55%);
      color: var(--text);
      font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
      padding: 16px;
    }
    .app {
      width: min(760px, 100%);
      background: rgba(17,24,39,0.92);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 20px;
      box-shadow: 0 20px 40px rgba(0,0,0,.35);
    }
    h1 { margin: 0 0 8px; font-size: 1.5rem; }
    p { margin: 0 0 18px; color: var(--muted); }
    .grid {
      display: grid;
      gap: 12px;
      grid-template-columns: repeat(2, minmax(0,1fr));
    }
    @media (max-width: 640px) {
      .grid { grid-template-columns: 1fr; }
    }
    label { font-size: 0.85rem; color: var(--muted); display:block; margin-bottom: 6px; }
    select, input {
      width: 100%;
      border: 1px solid var(--border);
      background: #0b1220;
      color: var(--text);
      border-radius: 10px;
      padding: 10px 12px;
      font-size: 1rem;
    }
    button {
      border: 1px solid var(--border);
      background: rgba(34,197,94,.2);
      color: var(--text);
      border-radius: 10px;
      padding: 10px 14px;
      font-size: 0.95rem;
      cursor: pointer;
      font-weight: 600;
    }
    .row { display:flex; gap: 10px; flex-wrap:wrap; align-items: end; margin-top: 8px; }
    .result {
      margin-top: 18px;
      padding: 14px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: rgba(148,163,184,.08);
      font-size: 1.08rem;
      font-variant-numeric: tabular-nums;
    }
    .muted { color: var(--muted); font-size: 0.9rem; margin-top: 10px; }
  </style>
</head>
<body>
  <main class="app">
    <h1>Imperial ↔ Metric Converter</h1>
    <p>Convert common length, weight, volume, area, speed, and temperature units in either direction.</p>

    <div class="grid">
      <div>
        <label for="fromUnit">From unit</label>
        <select id="fromUnit"></select>
      </div>
      <div>
        <label for="toUnit">To unit</label>
        <select id="toUnit"></select>
      </div>
      <div>
        <label for="inputValue">Value</label>
        <input id="inputValue" type="number" step="any" value="1" placeholder="Enter a value" />
      </div>
      <div class="row">
        <button id="convertBtn">Convert</button>
        <button id="swapBtn" type="button">Swap Units</button>
      </div>
    </div>

    <div class="result" id="result">1 mile = 1.609344 kilometer</div>
    <div class="muted">Tip: both units must be in the same category (example: distance to distance).</div>
  </main>

  <script>
    const unitMap = {
      // length
      inch:      { label: "inch (in)", category: "length", toBase: v => v * 0.0254, fromBase: v => v / 0.0254 },
      foot:      { label: "foot (ft)", category: "length", toBase: v => v * 0.3048, fromBase: v => v / 0.3048 },
      yard:      { label: "yard (yd)", category: "length", toBase: v => v * 0.9144, fromBase: v => v / 0.9144 },
      mile:      { label: "mile (mi)", category: "length", toBase: v => v * 1609.344, fromBase: v => v / 1609.344 },
      millimeter:{ label: "millimeter (mm)", category: "length", toBase: v => v / 1000, fromBase: v => v * 1000 },
      centimeter:{ label: "centimeter (cm)", category: "length", toBase: v => v / 100, fromBase: v => v * 100 },
      meter:     { label: "meter (m)", category: "length", toBase: v => v, fromBase: v => v },
      kilometer: { label: "kilometer (km)", category: "length", toBase: v => v * 1000, fromBase: v => v / 1000 },

      // mass
      ounce:     { label: "ounce (oz)", category: "mass", toBase: v => v * 0.028349523125, fromBase: v => v / 0.028349523125 },
      pound:     { label: "pound (lb)", category: "mass", toBase: v => v * 0.45359237, fromBase: v => v / 0.45359237 },
      ton_us:    { label: "short ton (US)", category: "mass", toBase: v => v * 907.18474, fromBase: v => v / 907.18474 },
      gram:      { label: "gram (g)", category: "mass", toBase: v => v / 1000, fromBase: v => v * 1000 },
      kilogram:  { label: "kilogram (kg)", category: "mass", toBase: v => v, fromBase: v => v },
      tonne:     { label: "tonne (metric ton)", category: "mass", toBase: v => v * 1000, fromBase: v => v / 1000 },

      // volume
      tsp:       { label: "teaspoon (tsp)", category: "volume", toBase: v => v * 0.00492892159375, fromBase: v => v / 0.00492892159375 },
      tbsp:      { label: "tablespoon (tbsp)", category: "volume", toBase: v => v * 0.01478676478125, fromBase: v => v / 0.01478676478125 },
      floz:      { label: "fluid ounce (US)", category: "volume", toBase: v => v * 0.0295735295625, fromBase: v => v / 0.0295735295625 },
      cup:       { label: "cup (US)", category: "volume", toBase: v => v * 0.2365882365, fromBase: v => v / 0.2365882365 },
      pint:      { label: "pint (US)", category: "volume", toBase: v => v * 0.473176473, fromBase: v => v / 0.473176473 },
      gallon:    { label: "gallon (US)", category: "volume", toBase: v => v * 3.785411784, fromBase: v => v / 3.785411784 },
      milliliter:{ label: "milliliter (mL)", category: "volume", toBase: v => v / 1000, fromBase: v => v * 1000 },
      liter:     { label: "liter (L)", category: "volume", toBase: v => v, fromBase: v => v },

      // area
      sqft:      { label: "square foot (ft²)", category: "area", toBase: v => v * 0.09290304, fromBase: v => v / 0.09290304 },
      acre:      { label: "acre", category: "area", toBase: v => v * 4046.8564224, fromBase: v => v / 4046.8564224 },
      sqm:       { label: "square meter (m²)", category: "area", toBase: v => v, fromBase: v => v },
      hectare:   { label: "hectare", category: "area", toBase: v => v * 10000, fromBase: v => v / 10000 },

      // speed
      mph:       { label: "mile per hour (mph)", category: "speed", toBase: v => v * 0.44704, fromBase: v => v / 0.44704 },
      kph:       { label: "kilometer per hour (km/h)", category: "speed", toBase: v => v * (1000 / 3600), fromBase: v => v / (1000 / 3600) },
      mps:       { label: "meter per second (m/s)", category: "speed", toBase: v => v, fromBase: v => v },

      // temperature (base unit = Celsius)
      fahrenheit:{ label: "fahrenheit (°F)", category: "temperature", toBase: v => (v - 32) * 5 / 9, fromBase: v => (v * 9 / 5) + 32 },
      celsius:   { label: "celsius (°C)", category: "temperature", toBase: v => v, fromBase: v => v },
      kelvin:    { label: "kelvin (K)", category: "temperature", toBase: v => v - 273.15, fromBase: v => v + 273.15 }
    };

    const fromUnit = document.getElementById("fromUnit");
    const toUnit = document.getElementById("toUnit");
    const inputValue = document.getElementById("inputValue");
    const result = document.getElementById("result");
    const convertBtn = document.getElementById("convertBtn");
    const swapBtn = document.getElementById("swapBtn");

    function formatNumber(n) {
      if (!Number.isFinite(n)) return "Invalid";
      return Number.parseFloat(n.toPrecision(12)).toString();
    }

    function populateUnits() {
      Object.entries(unitMap).forEach(([key, unit]) => {
        const opt1 = new Option(unit.label, key);
        const opt2 = new Option(unit.label, key);
        fromUnit.add(opt1);
        toUnit.add(opt2);
      });

      fromUnit.value = "mile";
      toUnit.value = "kilometer";
    }

    function convert() {
      const value = Number(inputValue.value);
      const from = unitMap[fromUnit.value];
      const to = unitMap[toUnit.value];

      if (!Number.isFinite(value)) {
        result.textContent = "Please enter a valid number.";
        return;
      }

      if (from.category !== to.category) {
        result.textContent = `Cannot convert ${from.category} to ${to.category}. Pick matching categories.`;
        return;
      }

      const baseValue = from.toBase(value);
      const converted = to.fromBase(baseValue);
      result.textContent = `${formatNumber(value)} ${from.label} = ${formatNumber(converted)} ${to.label}`;
    }

    function swap() {
      const prev = fromUnit.value;
      fromUnit.value = toUnit.value;
      toUnit.value = prev;
      convert();
    }

    convertBtn.addEventListener("click", convert);
    swapBtn.addEventListener("click", swap);
    fromUnit.addEventListener("change", convert);
    toUnit.addEventListener("change", convert);
    inputValue.addEventListener("input", convert);

    populateUnits();
    convert();
  </script>
</body>
</html>
